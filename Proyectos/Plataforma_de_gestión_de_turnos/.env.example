# ─── Plantilla de variables de entorno ─────────────────────
# Copiar este archivo como `.env` (desarrollo) o `.env.prod` (producción)
# y completar los valores. NUNCA subir los .env reales al repositorio.

# Puertos
INGRESS_PORT=20000
DB_PORT=20001

# Almacenamiento
VOLUME_DIR=./data
EXTERNAL_URL=http://localhost:20000
DOCKER_SOCKET=/var/run/docker.sock

# Base de datos
DB_APP_PASSWORD=tu-password-aca

# Resend (envío de emails) — obtener la key en https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_aca

# URL del frontend
FRONTEND_URL=http://localhost:20000
